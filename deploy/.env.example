# Copy to deploy/.env (same folder). SQL Server passwords need 8+ characters with upper case, lower case, a digit and a symbol.
MSSQL_SA_PASSWORD=ChangeMe_Sa#2026
APP_DB_PASSWORD=ChangeMe_App#2026
# Who is Super Admin on first start (must be in the HRMS table to get a name and profile).
SUPER_ADMIN_EMAIL=nimal.perera@rrd.com
# Optional: malware-scan every GenAI upload with ClamAV. Leave empty for no scan. To switch it on, set it to "clamav"
# and start with:  docker compose -f deploy/docker-compose.yml --profile scan up -d --build
GENAI_SCAN_HOST=
